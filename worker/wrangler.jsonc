{
  // Server ruangan Kafe Keliling Dunia. Lihat DEPLOY.md Bagian 2.
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "kafe-room",
  "main": "src/index.ts",
  "compatibility_date": "2026-11-01",
  "observability": { "enabled": true },
  "durable_objects": {
    "bindings": [{ "name": "ROOMS", "class_name": "KafeRoom" }]
  },
  // Paket gratis Cloudflare hanya mendukung Durable Object dengan backend SQLite.
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["KafeRoom"] }],
  "vars": {
    // Asal (origin) yang boleh memakai server ini, dipisah koma. "*" = wildcard satu bagian nama.
    // Ganti "cafe-abangade" bila nama proyek Pages Anda berbeda.
    "ALLOWED_ORIGINS": "https://cafe-abangade.pages.dev,https://*.cafe-abangade.pages.dev,http://localhost:*,http://127.0.0.1:*"
  }
}
